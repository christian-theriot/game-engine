# Standard Plane Mesh
#
#            4 ------------ 2
#           /              /
#          /              / 
#         /              /  
#        3 ------------ 1   
#
mtllib Plane.mtl
o Plane
v 1.000000 0.000000 1.000000
v 1.000000 0.000000 -1.000000
v -1.000000 0.000000 1.000000
v -1.000000 0.000000 -1.000000
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vn 0.000000 1.000000 0.000000
s off
usemtl Material
f 1/1/1 2/3/1 3/2/1
f 4/4/1 3/2/1 2/3/1
