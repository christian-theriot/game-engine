# Standard Cube Mesh
#
#            4 ------------ 2
#           /|             /|
#          / |            / |
#         /  |           /  |
#        3 ------------ 1   |
#        |   |          |   |
#        |   |          |   |
#        |   8 ---------|-- 6
#        |  /           |  /
#        | /            | /
#        |/             |/
#        7 ------------ 5
#
#
#
mtllib Cube.mtl
o Cube
v 1.000000 1.000000 1.000000
v 1.000000 1.000000 -1.000000
v -1.000000 1.000000 1.000000
v -1.000000 1.000000 -1.000000
v 1.000000 -1.000000 1.000000
v 1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 1.000000
v -1.000000 -1.000000 -1.000000
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vn 0.000000 0.000000 1.000000
vn 1.000000 0.000000 0.000000
vn 0.000000 1.000000 0.000000
vn 0.000000 0.000000 -1.000000
vn -1.000000 0.0000000 0.0000000
vn 0.000000 -1.0000000 0.000000
s off
usemtl Material
f 3/1/3 1/3/3 2/4/3 
f 4/2/3 3/1/3 2/4/3
f 1/1/1 5/3/1 6/4/1
f 1/1/1 6/4/1 2/2/1
f 2/1/4 6/3/4 8/4/4
f 2/1/4 8/4/4 4/2/4
f 8/3/5 3/2/5 4/1/5 
f 8/3/5 7/4/5 3/2/5 
f 3/1/1 7/3/1 5/4/1
f 5/4/1 1/2/1 3/1/1
f 7/1/6 8/3/6 5/2/6
f 8/3/6 6/4/6 5/2/6