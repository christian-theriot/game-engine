# Standard Octohedron Mesh
#
#
#                             5
#                             |
#                             |    3
#                             |   /
#                             |  /
#                             | /
#                             |/
#    (0.0, 0.0) 1 ----------------------------- 2
#                            /|
#                           / |
#                          /  |
#                         /   |
#                        4    |
#                             |
#                             6
#
#
mtllib Octohedron.mtl
o Octohedron
v -1.000000 0.000000 0.000000
v 1.000000 0.000000 0.000000
v 0.000000 0.000000 -1.000000
v 0.000000 0.000000 1.000000
v 0.000000 1.000000 0.000000
v 0.000000 -1.000000 0.000000
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 0.5 0.5
vn 1.000000 1.000000 1.000000
vn 1.000000 1.000000 -1.000000
vn 1.000000 -1.000000 1.000000
vn 1.000000 -1.000000 -1.000000
vn -1.000000 1.000000 1.000000
vn -1.000000 1.000000 -1.000000
vn -1.000000 -1.000000 1.000000
vn -1.000000 -1.000000 -1.000000
s off
usemtl Material
f 1/1/5 4/3/5 5/5/5
f 4/3/1 2/4/1 5/5/1
f 2/4/2 3/2/2 5/5/2
f 3/2/6 1/1/6 5/5/6
f 1/1/7 6/5/7 4/3/7
f 4/3/3 6/5/3 2/4/3
f 2/4/4 6/5/4 3/2/4
f 3/2/8 6/5/8 1/1/8